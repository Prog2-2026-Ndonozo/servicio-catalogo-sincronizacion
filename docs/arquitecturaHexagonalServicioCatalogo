    │   │       ├── CatedraSnapshotPort.java
    │   │       ├── CatedraCatalogReadPort.java
    │   │       └── SyncDiagnosticsPort.java
    │   └── service/                        ← implementaciones de los puertos "in", el corazón del dominio
